# Fieldnote reads these from the environment or a local .env file.
# .env is gitignored. Do not put real keys in the repo.

# mock | openai | anthropic | compatible
# mock runs the same tool-calling graph with deterministic rules. No key required.
LLM_PROVIDER=mock

# Used when LLM_PROVIDER is not mock.
# openai example: gpt-4o-mini
# anthropic example: claude-3-5-haiku-latest
# compatible example (Ollama): llama3.1
LLM_MODEL=gpt-4o-mini

# Required for openai and anthropic. For Ollama, any non-empty placeholder works.
LLM_API_KEY=

# Only for LLM_PROVIDER=compatible (Ollama, Groq, OpenRouter, other OpenAI-compatible APIs).
# Ollama example: http://127.0.0.1:11434/v1
LLM_BASE_URL=

LLM_TEMPERATURE=0

# The dataset's story happens in March 2026. The clock is not the wall clock.
# Overdue and "after the clock" use this date. ISO format.
AS_OF_DATE=2026-03-25

# Date shifts longer than this many days show on What changed.
CHANGE_SHIFT_DAYS=3

# Optional. When set, a draft posts a small JSON body here. Empty skips the call.
# N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/fieldnote-draft

# Optional overrides.
# FIELDNOTE_DB=data/fieldnote.db
# FIELDNOTE_SEED=fieldnote/seed
# FIELDNOTE_HOST=0.0.0.0
# PORT=43123
